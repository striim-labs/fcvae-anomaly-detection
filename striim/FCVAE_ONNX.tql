-- ============================================================================
-- FCVAE PENNY (ONNX): in-process penny-carding anomaly detection
--
-- Penny-carding use case: a single pooled FCVAE model ("Penny_All") scores the
-- hourly frequency of penny transactions (amount < $1), running INSIDE the
-- Striim JVM via ONNX Runtime. In-process ONNX replaces the FastAPI HTTP sidecar.
--
-- Windowing stays in Striim CQs (penny filter -> hourly count -> 24-row window).
-- The assembled 24-hour row is then converted to a Global.WAEvent with the
-- WAEUdf createWAEvent UDF, so the scorer can be a pure WAEvent pass-through
-- Open Processor wired DIRECTLY in TQL. No types JAR, no JAR-removal trick, no
-- Flow Designer. One CREATE TYPE (for the createWAEvent payload) is required.
--
-- Fully isolated: namespace fcvae_onnx, application FCVAEOnnxPenny, its own
-- /tmp/fcvae_onnx_penny_test I/O dir. Does not touch the production `fcvae` app.
--
-- PREREQUISITES (run in the Striim console BEFORE deploying):
--   1. Install the WAEUdf library JAR into $STRIIM_HOME/lib/ and restart Striim.
--        (SE add-on; see https://webaction.atlassian.net/wiki/spaces/SE/pages/2318336001 )
--        Confirm: the class com.webaction.helpers.WAEUdf is on the classpath.
--   2. Build + stage the OP:  striim/fcvae-onnx-scorer/build.sh
--   3. Load it:               LOAD OPEN PROCESSOR 'UploadedFiles/FCVAEOnnxScorer.scm';
--   4. Penny model bundle in  /opt/Striim/fcvae-models/Penny_All/
--        (model.onnx + model.onnx.data + model_config.json)
--   5. Penny transactions CSV in /tmp/fcvae_onnx_penny_test/
--
-- DEPLOY:
--   DEPLOY APPLICATION fcvae_onnx.FCVAEOnnxPenny;
--   START  APPLICATION fcvae_onnx.FCVAEOnnxPenny;
-- ============================================================================

CREATE NAMESPACE fcvae_onnx;
USE fcvae_onnx;

-- Striim type for the createWAEvent payload (5 fields -> data[0..4]). All String
-- so the data[] array is uniform; the OP reads each value as a string.
CREATE TYPE PennyPayloadType (
  combo_key    String,
  values_list  String,
  window_size  String,
  window_start String,
  window_end   String
);

CREATE APPLICATION FCVAEOnnxPenny;

-- ----------------------------------------------------------------------------
-- Ingest raw transaction rows from CSV (own input dir for isolation).
-- Columns: timestamp,network_type,transaction_type,amount,is_anomaly,penny_is_anomaly,split
-- ----------------------------------------------------------------------------
CREATE SOURCE PennyTxnFileSource USING FileReader (
  directory: '/tmp/fcvae_onnx_penny_test',
  wildcard: 'synthetic_transactions*.csv',
  positionByEOF: false
)
PARSE USING DSVParser (
  columndelimiter: ',',
  header: true
)
OUTPUT TO PennyRawTxnStream;

-- ----------------------------------------------------------------------------
-- Parse timestamp (data[0]) and amount (data[3]) from the raw WAEvent
-- ----------------------------------------------------------------------------
CREATE CQ PennyParseTxn
INSERT INTO PennyParsedStream
SELECT
  TO_DATEF(SLEFT(TO_STRING(data[0]), 19),
           'yyyy-MM-dd HH:mm:ss')   AS txn_timestamp,
  TO_DOUBLE(TO_STRING(data[3]))     AS amount
FROM PennyRawTxnStream;

-- ----------------------------------------------------------------------------
-- Filter to penny transactions only (amount < $1.00). All networks/types are
-- pooled into a single "Penny_All" key (single-model use case).
-- ----------------------------------------------------------------------------
CREATE CQ PennyFilter
INSERT INTO PennyFilteredStream
SELECT
  'Penny_All'    AS combo_key,
  txn_timestamp  AS txn_timestamp
FROM PennyParsedStream
WHERE amount < 1.00;

-- ----------------------------------------------------------------------------
-- Hourly aggregation (1-hour jumping window, event time)
-- ----------------------------------------------------------------------------
CREATE JUMPING WINDOW PennyHourlyWindow
OVER PennyFilteredStream
KEEP WITHIN 1 HOUR
ON txn_timestamp
PARTITION BY combo_key;

CREATE CQ PennyHourlyCounts
INSERT INTO PennyHourlyCountStream
SELECT
  w.combo_key                        AS combo_key,
  COUNT(*)                           AS txn_count,
  TO_STRING(FIRST(w.txn_timestamp))  AS hour_start,
  TO_STRING(LAST(w.txn_timestamp))   AS hour_end
FROM PennyHourlyWindow w
GROUP BY w.combo_key;

-- ----------------------------------------------------------------------------
-- Assemble the 24-hour sliding window into a typed row (implicit type).
-- ----------------------------------------------------------------------------
CREATE WINDOW PennyDailyWindow
OVER PennyHourlyCountStream
KEEP 24 ROWS
PARTITION BY combo_key;

CREATE CQ PennyAssembleDailyPayload
INSERT INTO PennyDailyPayloadTyped
SELECT
  w.combo_key                              AS combo_key,
  LIST(TO_STRING(w.txn_count))             AS values_list,
  TO_STRING(COUNT(*))                      AS window_size,
  TO_STRING(FIRST(w.hour_start))           AS window_start,
  TO_STRING(LAST(w.hour_start))            AS window_end
FROM PennyDailyWindow w
GROUP BY w.combo_key
HAVING COUNT(*) >= 24;

-- ----------------------------------------------------------------------------
-- Convert the typed payload row to a Global.WAEvent via the WAEUdf library, so
-- the pass-through OP can consume it. The 5 fields land positionally in data[]:
--   data[0]=combo_key  data[1]=values_list  data[2]=window_size
--   data[3]=window_start  data[4]=window_end
-- ----------------------------------------------------------------------------
CREATE STREAM PennyDailyPayloadStream OF Global.WAEvent;

CREATE CQ PennyToWaevent
INSERT INTO PennyDailyPayloadStream
SELECT com.webaction.helpers.WAEUdf.createWAEvent(
  'fcvae_onnx.PennyPayloadType',
  'Penny_All',
  'INSERT',
  java.util.Arrays.asList(p.combo_key, p.values_list, p.window_size, p.window_start, p.window_end).toArray(),
  java.util.Arrays.asList(p.combo_key, p.values_list, p.window_size, p.window_start, p.window_end).toArray()
)
FROM PennyDailyPayloadTyped p;

-- ----------------------------------------------------------------------------
-- Score in-process with ONNX Runtime (single Penny_All model). The OP appends
-- results to data[]:  data[5]=is_anomaly  data[6]=anomaly_score  data[7]=threshold
-- ----------------------------------------------------------------------------
CREATE STREAM PennyScoredStream OF Global.WAEvent;

CREATE OPEN PROCESSOR PennyOnnxProc USING Global.FCVAEOnnxScorer (
  ModelDir: '/opt/Striim/fcvae-models/Penny_All',
  ValuesIndex: 1,
  ComboKeyIndex: 0,
  WindowEndIndex: 4,
  EnableLogging: true
)
INSERT INTO PennyScoredStream
FROM PennyDailyPayloadStream;

-- ----------------------------------------------------------------------------
-- Project data[] into named fields for the formatter (formatters cannot read
-- userdata, so the OP put the results in data[]).
-- ----------------------------------------------------------------------------
CREATE CQ PennyFormatScored
INSERT INTO PennyScorerResultReady
SELECT
  TO_STRING(data[0]) AS combo_key,
  TO_STRING(data[4]) AS window_end,
  TO_STRING(data[5]) AS is_anomaly,
  TO_STRING(data[6]) AS anomaly_score,
  TO_STRING(data[7]) AS threshold
FROM PennyScoredStream;

-- ----------------------------------------------------------------------------
-- Write scored results to JSON (own output dir for isolation)
-- ----------------------------------------------------------------------------
CREATE TARGET PennyResultFile USING FileWriter (
  directory: '/tmp/fcvae_onnx_penny_test',
  filename: 'penny_scored_output'
)
FORMAT USING JSONFormatter ()
INPUT FROM PennyScorerResultReady;

END APPLICATION FCVAEOnnxPenny;
