# FCVAE Scoring API Configuration
# Copy to .env and adjust as needed. All variables are optional — defaults shown.

# Path to trained model artifacts directory
FCVAE_MODEL_PATH=models/fcvae

# Version tag returned in API responses
FCVAE_MODEL_VERSION=1.0.0

# Number of latent samples for NLL scoring (higher = more stable, slower)
FCVAE_N_SAMPLES=16

# Scoring mode: "single_pass" (fast, streaming) or "mcmc" (accurate, evaluation)
FCVAE_SCORE_MODE=single_pass

# Inference device: "cpu" or "cuda"
FCVAE_DEVICE=cpu

# API key for authentication. Empty string disables auth.
# For production, generate a strong key and store in a secret manager.
FCVAE_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR
FCVAE_LOG_LEVEL=INFO

# --- Shared variables (used by other services too) ---

# Kafka producer delay between messages (seconds)
MESSAGE_DELAY_SECONDS=1

# Which combo to stream in the producer / Dash app
COMBO=Accel_nopin

# Data split for the producer: train, val, test
DATA_SPLIT=test

# Number of latent samples (shared with Dash app)
N_SAMPLES=16
