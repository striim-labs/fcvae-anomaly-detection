# FCVAE Weekly Retrain — Example Crontab Entry
#
# Runs every Sunday at 2:00 AM UTC. Adjust the schedule, paths, and
# environment variables to match your deployment.
#
# Install with:
#   crontab -e   # then paste the line below (uncommented)
#
# Or install non-interactively:
#   (crontab -l 2>/dev/null; echo '0 2 * * 0 FCVAE_API_URL=http://localhost:8000 /opt/fcvae/scripts/weekly_retrain.sh >> /var/log/fcvae_retrain.log 2>&1') | crontab -

0 2 * * 0 FCVAE_API_URL=http://localhost:8000 /opt/fcvae/scripts/weekly_retrain.sh >> /var/log/fcvae_retrain.log 2>&1

# ── Variations ───────────────────────────────────────────────────────────────
#
# With API key authentication:
# 0 2 * * 0 FCVAE_API_URL=http://localhost:8000 FCVAE_API_KEY=your-secret-key /opt/fcvae/scripts/weekly_retrain.sh >> /var/log/fcvae_retrain.log 2>&1
#
# Every night at 3 AM (daily retrain):
# 0 3 * * * FCVAE_API_URL=http://localhost:8000 /opt/fcvae/scripts/weekly_retrain.sh >> /var/log/fcvae_retrain.log 2>&1
#
# Biweekly (1st and 15th of each month):
# 0 2 1,15 * * FCVAE_API_URL=http://localhost:8000 /opt/fcvae/scripts/weekly_retrain.sh >> /var/log/fcvae_retrain.log 2>&1
